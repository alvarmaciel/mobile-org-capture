# Copy outside the repository to /etc/mobile-org-capture/mobile-org-capture.env with mode 0600.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
CAPTURE_QUEUE_DIR=/var/lib/mobile-org-capture/queue
ORG_INBOX_PATH=/srv/org/inbox.org
ORG_ARTIFACTS_DIR=/srv/org/artifacts
ORG_ARTIFACTS_LINK_PREFIX=artifact:
CAPTURE_TIMEZONE=America/Argentina/Buenos_Aires
MAX_ATTACHMENT_BYTES=20971520
CAPTURE_SWEEP_INTERVAL=30
