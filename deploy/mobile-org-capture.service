[Unit]
Description=Captura Movil Telegram to Org service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=captura
Group=captura
WorkingDirectory=/opt/mobile-org-capture
EnvironmentFile=/etc/mobile-org-capture/mobile-org-capture.env
ExecStart=/opt/mobile-org-capture/.venv/bin/python -m mobile_org_capture
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
